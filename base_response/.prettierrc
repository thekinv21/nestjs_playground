{
	"trailingComma": "none",
	"tabWidth": 2,
	"useTabs": true,
	"semi": false,
	"singleQuote": true,
	"jsxSingleQuote": true,
	"arrowParens": "avoid",
	"plugins": ["@trivago/prettier-plugin-sort-imports"],
	"importOrder": [
		"^@nestjs/(.*)$",
		"^nestjs/(.*)$",
		"<THIRD_PARTY_MODULES>",
		"^@/app(/.*)?$",
		"^@/domain(/.*)?$",
		"^@/infrastructure(/.*)?$",
		"^@/presentation(/.*)?$",
		"^@/use-cases(/.*)?$",
		"^@/shared(/.*)?$",
		"^@/(.*)$",
		"^[./]"
	],
	"importOrderSeparation": true,
	"importOrderSortSpecifiers": true,
	"importOrderGroupNamespaceSpecifiers": true,
	"importOrderCaseInsensitive": true,
	"overrides": [
		{
			"files": "*.ts",
			"options": {
				"parser": "babel-ts"
			}
		}
	]
}